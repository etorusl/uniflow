# Generated local credentials are written by pnpm env:init. Do not reuse them in production.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
WEB_ORIGIN=http://localhost:8081
EXPO_PUBLIC_API_URL=http://localhost:3000

POSTGRES_USER=uniflow
POSTGRES_PASSWORD=replace-local-database-password
POSTGRES_DB=uniflow
POSTGRES_PORT=5432
DATABASE_URL=postgresql://uniflow:replace-local-database-password@127.0.0.1:5432/uniflow

S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_BUCKET=uniflow
S3_ACCESS_KEY_ID=replace-local-access-key
S3_SECRET_ACCESS_KEY=replace-local-secret-key

SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=UniFlow <hello@uniflow.local>
SMTP_SECURE=false
MAILPIT_PORT=8025

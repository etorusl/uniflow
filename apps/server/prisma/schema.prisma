generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// Operational probe used by the internal CLI to verify the separate worker.
model JobProbe {
  id          String    @id @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  completedAt DateTime? @db.Timestamptz(3)

  @@map("job_probes")
}

enum ActionPurpose {
  RESET_PASSWORD
}

model User {
  id              String        @id @default(uuid()) @db.Uuid
  email           String        @unique
  passwordHash    String
  displayName     String
  timeZone        String        @default("UTC")
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(3)
  sessions        Session[]
  actionTokens    ActionToken[]
  subjects        Subject[]
  teachers        Teacher[]
  semesters       Semester[]
  scheduleEntries ScheduleEntry[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model ActionToken {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @db.Uuid
  tokenHash String        @unique
  purpose   ActionPurpose
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  expiresAt DateTime      @db.Timestamptz(3)
  usedAt    DateTime?     @db.Timestamptz(3)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("action_tokens")
}

model AuthRateLimit {
  key          String   @id
  count        Int
  windowEndsAt DateTime @db.Timestamptz(3)

  @@index([windowEndsAt])
  @@map("auth_rate_limits")
}

enum WeekParity {
  ALL
  EVEN
  ODD
}

model Subject {
  id      String @id @default(uuid()) @db.Uuid
  userId  String @db.Uuid
  name    String
  color   String @default("#6554D9")
  user    User @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries ScheduleEntry[]
  @@index([userId, name])
  @@map("subjects")
}

model Teacher {
  id      String @id @default(uuid()) @db.Uuid
  userId  String @db.Uuid
  name    String
  email   String?
  phone   String?
  notes   String?
  user    User @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries ScheduleEntry[]
  @@index([userId, name])
  @@map("teachers")
}

model Semester {
  id            String @id @default(uuid()) @db.Uuid
  userId        String @db.Uuid
  name          String
  startDate     DateTime @db.Date
  endDate       DateTime @db.Date
  weekStartDate DateTime @db.Date
  timeZone      String
  user          User @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries       ScheduleEntry[]
  @@index([userId, startDate])
  @@map("semesters")
}

model ScheduleEntry {
  id         String @id @default(uuid()) @db.Uuid
  userId     String @db.Uuid
  semesterId String @db.Uuid
  subjectId  String @db.Uuid
  teacherId  String? @db.Uuid
  dayOfWeek  Int
  startTime  String
  endTime    String
  parity     WeekParity @default(ALL)
  room       String?
  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
  semester   Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  subject    Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  teacher    Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  exceptions ScheduleException[]
  @@index([userId, semesterId])
  @@map("schedule_entries")
}

model ScheduleException {
  id              String @id @default(uuid()) @db.Uuid
  entryId         String @db.Uuid
  originalDate    DateTime @db.Date
  cancelled       Boolean
  replacementDate DateTime? @db.Date
  startTime       String?
  endTime         String?
  entry           ScheduleEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  @@unique([entryId, originalDate])
  @@map("schedule_exceptions")
}

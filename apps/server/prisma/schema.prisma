generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// Operational probe used by the internal CLI to verify the separate worker.
model JobProbe {
  id          String    @id @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  completedAt DateTime? @db.Timestamptz(3)

  @@map("job_probes")
}

enum ActionPurpose {
  RESET_PASSWORD
}

model User {
  id              String        @id @default(uuid()) @db.Uuid
  email           String        @unique
  passwordHash    String
  displayName     String
  timeZone        String        @default("UTC")
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(3)
  sessions        Session[]
  actionTokens    ActionToken[]
  subjects        Subject[]
  teachers        Teacher[]
  semesters       Semester[]
  scheduleEntries ScheduleEntry[]
  tasks           Task[]
  ownedGroups     StudyGroup[]
  groupMemberships GroupMember[]
  groupInvitations GroupInvitation[]
  groupActions GroupAuditEvent[]
  authoredGroupTasks GroupTask[] @relation("GroupTaskAuthor")
  closedGroupTasks GroupTask[] @relation("GroupTaskCloser")
  groupTaskCompletions GroupTaskCompletion[]
  groupTaskEvents GroupTaskEvent[]
  uploadedAttachments Attachment[] @relation("AttachmentUploader")
  authoredGroupMaterials GroupMaterial[] @relation("MaterialAuthor")
  reminderPreference ReminderPreference?
  pushSubscriptions PushSubscription[]
  reminderNotices ReminderNotice[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pushSubscriptions PushSubscription[]

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model ActionToken {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @db.Uuid
  tokenHash String        @unique
  purpose   ActionPurpose
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  expiresAt DateTime      @db.Timestamptz(3)
  usedAt    DateTime?     @db.Timestamptz(3)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("action_tokens")
}

model AuthRateLimit {
  key          String   @id
  count        Int
  windowEndsAt DateTime @db.Timestamptz(3)

  @@index([windowEndsAt])
  @@map("auth_rate_limits")
}

enum WeekParity {
  ALL
  EVEN
  ODD
}

model Subject {
  id      String @id @default(uuid()) @db.Uuid
  userId  String @db.Uuid
  name    String
  color   String @default("#6554D9")
  user    User @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries ScheduleEntry[]
  tasks   Task[]
  groupLinks GroupMember[]
  @@index([userId, name])
  @@map("subjects")
}

model Teacher {
  id      String @id @default(uuid()) @db.Uuid
  userId  String @db.Uuid
  name    String
  email   String?
  phone   String?
  notes   String?
  user    User @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries ScheduleEntry[]
  @@index([userId, name])
  @@map("teachers")
}

model Semester {
  id            String @id @default(uuid()) @db.Uuid
  userId        String @db.Uuid
  name          String
  startDate     DateTime @db.Date
  endDate       DateTime @db.Date
  weekStartDate DateTime @db.Date
  timeZone      String
  user          User @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries       ScheduleEntry[]
  @@index([userId, startDate])
  @@map("semesters")
}

model ScheduleEntry {
  id         String @id @default(uuid()) @db.Uuid
  userId     String @db.Uuid
  semesterId String @db.Uuid
  subjectId  String @db.Uuid
  teacherId  String? @db.Uuid
  dayOfWeek  Int
  startTime  String
  endTime    String
  parity     WeekParity @default(ALL)
  room       String?
  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
  semester   Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  subject    Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  teacher    Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  exceptions ScheduleException[]
  @@index([userId, semesterId])
  @@map("schedule_entries")
}

model ScheduleException {
  id              String @id @default(uuid()) @db.Uuid
  entryId         String @db.Uuid
  originalDate    DateTime @db.Date
  cancelled       Boolean
  replacementDate DateTime? @db.Date
  startTime       String?
  endTime         String?
  entry           ScheduleEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  @@unique([entryId, originalDate])
  @@map("schedule_exceptions")
}

enum TaskEventKind {
  COMPLETED
  REOPENED
}

model Task {
  id                   String @id @default(uuid()) @db.Uuid
  userId               String @db.Uuid
  subjectId            String? @db.Uuid
  title                String
  description          String @default("")
  dueAt                DateTime @db.Timestamptz(3)
  deadlineRevision     Int @default(1)
  completedAt          DateTime? @db.Timestamptz(3)
  deadlineAtCompletion DateTime? @db.Timestamptz(3)
  createdAt            DateTime @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @db.Timestamptz(3)
  user                 User @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject              Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  history              TaskEvent[]
  attachments          Attachment[]
  @@index([userId, dueAt, id])
  @@index([userId, completedAt])
  @@map("tasks")
}

model TaskEvent {
  id               String @id @default(uuid()) @db.Uuid
  taskId           String @db.Uuid
  kind             TaskEventKind
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  deadlineSnapshot DateTime @db.Timestamptz(3)
  task             Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  @@index([taskId, createdAt])
  @@map("task_events")
}

enum GroupMemberRole {
  MEMBER
  MODERATOR
}

enum GroupTaskMode {
  INDIVIDUAL
  SHARED
}

model StudyGroup {
  id           String @id @default(uuid()) @db.Uuid
  ownerId      String @db.Uuid
  name         String
  subjectName  String
  description  String @default("")
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
  archivedAt   DateTime? @db.Timestamptz(3)
  owner        User @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  ownerMembership GroupMember @relation("GroupOwnerMembership", fields: [id, ownerId], references: [groupId, userId], onDelete: NoAction, onUpdate: NoAction, map: "study_groups_owner_member_fkey")
  members      GroupMember[]
  invitations  GroupInvitation[]
  audit        GroupAuditEvent[]
  tasks        GroupTask[]
  materials    GroupMaterial[]
  @@index([ownerId])
  @@map("study_groups")
}

model GroupMember {
  groupId   String @db.Uuid
  userId    String @db.Uuid
  role      GroupMemberRole @default(MEMBER)
  subjectId String? @db.Uuid
  joinedAt  DateTime @default(now()) @db.Timestamptz(3)
  leftAt    DateTime? @db.Timestamptz(3)
  blockedAt DateTime? @db.Timestamptz(3)
  group     StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  ownedGroups StudyGroup[] @relation("GroupOwnerMembership")
  @@id([groupId, userId])
  @@index([userId, leftAt])
  @@index([groupId, leftAt, joinedAt])
  @@map("group_members")
}

model GroupInvitation {
  id          String @id @default(uuid()) @db.Uuid
  groupId     String @db.Uuid
  creatorId   String? @db.Uuid
  tokenHash   String @unique
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  expiresAt   DateTime @db.Timestamptz(3)
  revokedAt   DateTime? @db.Timestamptz(3)
  maxUses     Int
  uses        Int @default(0)
  group       StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  creator     User? @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  @@index([groupId, expiresAt])
  @@map("group_invitations")
}

model GroupAuditEvent {
  id           String @id @default(uuid()) @db.Uuid
  groupId      String @db.Uuid
  actorId      String? @db.Uuid
  targetUserId String? @db.Uuid
  kind         String
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  group        StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  actor        User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  @@index([groupId, createdAt])
  @@map("group_audit_events")
}

model GroupTask {
  id                   String @id @default(uuid()) @db.Uuid
  groupId              String @db.Uuid
  authorId             String? @db.Uuid
  mode                 GroupTaskMode
  title                String
  description          String @default("")
  dueAt                DateTime @db.Timestamptz(3)
  deadlineRevision     Int @default(1)
  completedAt          DateTime? @db.Timestamptz(3)
  deadlineAtCompletion DateTime? @db.Timestamptz(3)
  completedById        String? @db.Uuid
  createdAt            DateTime @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @db.Timestamptz(3)
  deletedAt            DateTime? @db.Timestamptz(3)
  group                StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  author               User? @relation("GroupTaskAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  completedBy          User? @relation("GroupTaskCloser", fields: [completedById], references: [id], onDelete: SetNull)
  completions          GroupTaskCompletion[]
  history              GroupTaskEvent[]
  attachments          Attachment[]
  @@index([groupId, deletedAt, dueAt, id])
  @@map("group_tasks")
}

model GroupTaskCompletion {
  taskId               String @db.Uuid
  userId               String @db.Uuid
  completedAt          DateTime @db.Timestamptz(3)
  deadlineAtCompletion DateTime @db.Timestamptz(3)
  task                 GroupTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user                 User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([taskId, userId])
  @@index([userId, taskId])
  @@map("group_task_completions")
}

model GroupTaskEvent {
  id               String @id @default(uuid()) @db.Uuid
  taskId           String @db.Uuid
  actorId          String? @db.Uuid
  kind             TaskEventKind
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  deadlineSnapshot DateTime @db.Timestamptz(3)
  task             GroupTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor            User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  @@index([taskId, createdAt, id])
  @@index([taskId, actorId, createdAt, id])
  @@map("group_task_events")
}

enum AttachmentState {
  PENDING
  READY
  DELETING
}

model Attachment {
  id          String          @id @default(uuid()) @db.Uuid
  uploaderId  String?         @db.Uuid
  taskId      String?         @db.Uuid
  groupTaskId String?         @db.Uuid
  materialId  String?         @db.Uuid
  objectKey   String          @unique
  name        String
  mimeType    String
  size        Int
  state       AttachmentState @default(PENDING)
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  uploader    User?          @relation("AttachmentUploader", fields: [uploaderId], references: [id], onDelete: SetNull)
  task        Task?          @relation(fields: [taskId], references: [id], onDelete: SetNull)
  groupTask   GroupTask?     @relation(fields: [groupTaskId], references: [id], onDelete: SetNull)
  material    GroupMaterial? @relation(fields: [materialId], references: [id], onDelete: SetNull)

  @@index([taskId, state, createdAt])
  @@index([groupTaskId, state, createdAt])
  @@index([materialId, state, createdAt])
  @@index([uploaderId, state])
  @@index([state, createdAt])
  @@map("attachments")
}

model GroupMaterial {
  id          String       @id @default(uuid()) @db.Uuid
  groupId     String       @db.Uuid
  authorId    String?      @db.Uuid
  title       String
  description String       @default("")
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)
  group       StudyGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  author      User?        @relation("MaterialAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  attachments Attachment[]

  @@index([groupId, createdAt, id])
  @@index([authorId])
  @@map("group_materials")
}

enum PushTransport {
  WEB
  ANDROID
}

enum ReminderTaskKind {
  PERSONAL
  GROUP
}

enum ReminderDeliveryStatus {
  PENDING
  SENDING
  SENT
  SKIPPED
  FAILED
}

model ReminderPreference {
  userId        String   @id @db.Uuid
  enabled       Boolean  @default(false)
  minutesBefore Int      @default(60)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reminder_preferences")
}

model PushSubscription {
  id          String             @id @default(uuid()) @db.Uuid
  userId      String             @db.Uuid
  sessionId   String?            @db.Uuid
  transport   PushTransport
  fingerprint String             @unique
  address     String
  p256dh      String?
  authSecret  String?
  updatedAt   DateTime           @updatedAt @db.Timestamptz(3)
  revokedAt   DateTime?          @db.Timestamptz(3)
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  session     Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  deliveries  ReminderDelivery[]

  @@index([userId, revokedAt])
  @@index([sessionId, transport, revokedAt])
  @@map("push_subscriptions")
}

model ReminderRevision {
  key       String   @id
  version   Int      @default(1)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("reminder_revisions")
}

model ReminderDelivery {
  id             String                 @id @default(uuid()) @db.Uuid
  subscriptionId String                @db.Uuid
  userId         String                 @db.Uuid
  kind           ReminderTaskKind
  taskId         String                 @db.Uuid
  generation     String
  scheduledAt    DateTime              @db.Timestamptz(3)
  status         ReminderDeliveryStatus @default(PENDING)
  attempts       Int                    @default(0)
  lastResult     String?
  updatedAt      DateTime               @updatedAt @db.Timestamptz(3)
  subscription   PushSubscription       @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, kind, taskId, generation])
  @@index([status, updatedAt])
  @@map("reminder_deliveries")
}

model ReminderNotice {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @db.Uuid
  kind        ReminderTaskKind
  taskId      String           @db.Uuid
  groupId     String?          @db.Uuid
  generation  String
  scheduledAt DateTime         @db.Timestamptz(3)
  createdAt   DateTime?        @db.Timestamptz(3)
  readAt      DateTime?        @db.Timestamptz(3)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, taskId, generation])
  @@index([userId, createdAt])
  @@map("reminder_notices")
}

{
  "name": "@uniflow/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "dev": "pnpm build && concurrently --kill-others -n compiler,api,worker \"tsc -p tsconfig.json --watch --preserveWatchOutput\" \"node --watch dist/main.js\" \"node --watch dist/worker.js\"",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "queue:probe": "node dist/cli/queue-probe.js",
    "storage:init": "node dist/cli/storage-init.js",
    "openapi": "node dist/cli/openapi.js",
    "test": "node --test test/unit/*.test.mjs",
    "test:integration": "node --test --test-concurrency=1 test/integration/*.test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1156.0",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/swagger": "12.0.4",
    "@opentelemetry/api": "1.10.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "helmet": "8.3.0",
    "nodemailer": "7.0.13",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/nodemailer": "7.0.12",
    "@types/pg": "8.23.1",
    "@uniflow/config": "workspace:*",
    "concurrently": "10.0.6",
    "prisma": "7.10.1",
    "typescript": "6.0.3"
  }
}
